# NutriCoach deployment settings.
# Copy to .env, then run ./scripts/init-deployment.sh <local|lan|https>.
# Plaintext passwords are not stored here.

COMPOSE_PROJECT_NAME=nutricoach

POSTGRES_DB=nutricoach
POSTGRES_USER=nutricoach
DATABASE_POOL_SIZE=10

# Local mode binds both services to loopback. For trusted-LAN mode,
# init-deployment.sh changes WEB_BIND_ADDRESS to 0.0.0.0 while the backend
# remains loopback-only.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8081
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080

# HTTPS mode only. Use a real DNS name that points to the server.
NUTRICOACH_SITE_ADDRESS=nutricoach.example.com
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443
