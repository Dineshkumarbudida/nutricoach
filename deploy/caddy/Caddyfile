{
    # The admin API is not needed for this immutable Compose deployment.
    admin off
}

{$NUTRICOACH_SITE_ADDRESS} {
    encode zstd gzip

    # Actuator is used for container health checks only and is not public.
    @blocked path /actuator /actuator/*
    respond @blocked 404

    # The generated secret contains one line: <username> <password-hash>.
    basic_auth {
        import /run/secrets/caddy_users
    }

    request_body {
        max_size 2MB
    }

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    reverse_proxy web:8081 {
        # The outer Basic Authentication credential is not application data.
        header_up -Authorization
    }
}
